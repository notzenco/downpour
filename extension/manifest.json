{
  "manifest_version": 3,
  "name": "Downpour",
  "version": "0.1.0",
  "description": "Send downloads and links to the Downpour download manager.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Downpour",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "downpour@zenco.cc",
      "strict_min_version": "121.0"
    }
  }
}
